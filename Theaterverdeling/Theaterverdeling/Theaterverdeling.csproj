<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Theaterverdeling</RootNamespace>
    <AssemblyName>Theaterverdeling</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <ApplicationIcon></ApplicationIcon>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Properties\app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Crountch-One-Piece-Jolly-Roger-Ace.ico" />
    <Content Include="Zalen\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>