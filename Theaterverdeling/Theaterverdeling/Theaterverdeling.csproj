<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Theaterverdeling</RootNamespace>
    <AssemblyName>Theaterverdeling</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <ApplicationIcon>Theaterverdeling.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Properties\app.manifest" />
    <EmbeddedResource Include="Theaterverdeling.ico" LogicalName="Theaterverdeling.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Zalen\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="LEESMIJ.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>